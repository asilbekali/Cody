# Copy to .env.local and fill in. All of these are also set in Vercel:
#   Project -> Settings -> Environment Variables

# Owner (studio) credentials — the only account that can publish.
OWNER_USERNAME=your-username
OWNER_PASSWORD=your-strong-password

# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public branding.
NEXT_PUBLIC_SITE_NAME=Cody
NEXT_PUBLIC_SITE_DESCRIPTION="Writing, photographs and video — published as they happen."

# Injected automatically by Vercel once a Blob store is connected.
# Leave blank locally to use the on-disk fallback.
BLOB_READ_WRITE_TOKEN="token"
